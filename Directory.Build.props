<Project>
  <!--
    Local build secrets, untracked. Holds the OAuth client secret that cannot live in a public
    repository but still has to be compiled into shipped builds. Absent on a fresh clone and on
    CI, which is correct: Google Drive then reports itself unconfigured rather than failing at
    sign-in with something unexplainable. See .claude/docs/sync.md.
  -->
  <Import Project="$(MSBuildThisFileDirectory)local.secrets.props"
          Condition="Exists('$(MSBuildThisFileDirectory)local.secrets.props')" />

  <!-- Single source of truth for the app version -->
  <PropertyGroup>
    <Version>1.27.1</Version>
  </PropertyGroup>

  <!--
    Auto-detect the build platform from the OS architecture when no explicit
    Platform is provided (i.e. plain "dotnet build" without -p:Platform=...).
    MSBuild defaults to AnyCPU, which isn't in our Platforms list and would
    fall back to the first entry (x64) — wrong on ARM64 machines.
  -->
  <PropertyGroup Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">
    <Platform Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">ARM64</Platform>
    <Platform Condition="'$(PROCESSOR_ARCHITECTURE)' != 'ARM64'">x64</Platform>
  </PropertyGroup>
</Project>
