<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap com">

  <Identity
    Name="27766TechnicallyReal.LittleLauncher"
    Publisher="CN=C21E6CEF-D0D1-4497-93F9-3718D054DA0E"
    Version="VERSION_PLACEHOLDER"
    ProcessorArchitecture="ARCH_PLACEHOLDER" />

  <Properties>
    <DisplayName>Little Launcher</DisplayName>
    <PublisherDisplayName>TechnicallyReal</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.770.947.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="LittleLauncher.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Little Launcher"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\LittleLauncher.png"
        Description="A launcher widget embedded in the Windows 11 taskbar with SSH/SFTP settings sync.">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"  ShortName="Little Launcher" Square71x71Logo="Images\SmallTile.png" Square310x310Logo="Images\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square150x150Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask
            TaskId="LittleLauncherStartup"
            Enabled="false"
            DisplayName="Little Launcher" />
        </desktop:Extension>

        <!-- Toast activation. A packaged app needs somewhere for a clicked notification to go,
             which is this COM server; without it AppNotificationManager.Register() can throw,
             which is why registration used to be skipped for packaged builds entirely.
             The CLSID is this app's identity to the notification platform — it must stay
             stable, or previously delivered toasts lose their activator. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="LittleLauncher.exe"
                           DisplayName="Little Launcher"
                           Arguments="----AppNotificationActivated:">
              <com:Class Id="9C7A1E42-6B58-4F3D-9D21-3A5C0E7B4F16"
                         DisplayName="Little Launcher Notification Activator" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- desktop:, not uap: — the uap form of this extension is UWP-only, and makeappx
             rejects it for a full-trust desktop package with an enumeration-constraint error. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="9C7A1E42-6B58-4F3D-9D21-3A5C0E7B4F16" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
