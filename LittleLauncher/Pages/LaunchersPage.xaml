<Page x:Class="LittleLauncher.Pages.LaunchersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel MaxWidth="450" Margin="16">

                    <TextBlock Text="Launchers" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Each launcher has its own set of launcher items and its own tray icon."
                               FontSize="13" Opacity="0.6" Margin="0,0,0,20"/>

                    <!-- Keep creation in one menu above the cards. The messaging presets are
                         inserted between custom creation and shared-link creation in code,
                         so choosing a service creates and opens it in two clicks. -->
                    <Button x:Name="AddLauncherButton" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add Launcher"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="AddLauncherMenu" Placement="Bottom">
                                <MenuFlyoutItem Text="Shortcuts" Click="AddLauncherButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- A web launcher is otherwise only discoverable by opening
                                     launcher settings and noticing the Type dropdown. -->
                                <MenuFlyoutItem Text="Web page" Click="AddWebLauncherButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE774;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="SharedLauncherSeparator"/>
                                <MenuFlyoutItem Text="From a shared link…" Click="AddSharedLauncherButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE753;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Cards live in their own container, so rebuilding them cannot take the
                         heading and the Add button with them. The previous version emptied the
                         whole panel down to its last child, which deleted both TextBlocks above
                         on the first rebuild - and that runs in the constructor. -->
                    <StackPanel x:Name="LauncherCardsPanel" Margin="0,0,0,60"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
