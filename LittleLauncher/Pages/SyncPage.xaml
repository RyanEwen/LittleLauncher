<Page x:Class="LittleLauncher.Pages.SyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Every destination expander looks the same: full width, content stretched, so the
             rows read as one list rather than five differently-sized cards. -->
        <Style x:Key="DestinationExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="Cloud Sync" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Keep your launchers in sync across machines, through OneDrive, Google Drive, WebDAV, a folder or network share, or your own SSH/SFTP server."
                   FontSize="14" Opacity="0.6" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="Destinations" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBlock Text="Switch on as many as you like. Every change uploads to all of them; a download takes whichever holds the newest copy. Expand one to set it up."
                   FontSize="12" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- ── SSH / SFTP ── -->


        <!-- ── OneDrive ── -->
        <Expander x:Name="OneDriveExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OneDrive" FontSize="14"/>
                        <TextBlock x:Name="OneDriveStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="OneDriveToggle" Tag="1"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock x:Name="OneDriveHint" FontSize="12" Opacity="0.6"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OneDriveSignIn" Content="Sign in..." Tag="1" Click="SignIn_Click"/>
                    <Button x:Name="OneDriveSignOut" Content="Sign out" Tag="1" Click="SignOut_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="OneDriveNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── Google Drive ── -->
        <Expander x:Name="GoogleExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Google Drive" FontSize="14"/>
                        <TextBlock x:Name="GoogleStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="GoogleToggle" Tag="2"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock x:Name="GoogleHint" FontSize="12" Opacity="0.6"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="GoogleSignIn" Content="Sign in..." Tag="2" Click="SignIn_Click"/>
                    <Button x:Name="GoogleSignOut" Content="Sign out" Tag="2" Click="SignOut_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="GoogleNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── WebDAV ── -->
        <Expander x:Name="WebDavExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WebDAV (Nextcloud, ownCloud...)" FontSize="14"/>
                        <TextBlock x:Name="WebDavStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="WebDavToggle" Tag="5"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Folder URL" FontSize="14"/>
                            <TextBlock Text="e.g. https://cloud.example.com/remote.php/dav/files/me/LittleLauncher/"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" Width="320" VerticalAlignment="Center"
                                 Text="{Binding WebDavUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Username" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Width="240" VerticalAlignment="Center"
                                 Text="{Binding WebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Password" FontSize="14"/>
                            <TextBlock x:Name="WebDavPasswordHint" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PasswordBox x:Name="WebDavPasswordBox" Width="200"/>
                            <Button x:Name="WebDavConnectButton" Content="Connect" Click="WebDavConnect_Click"/>
                            <Button x:Name="WebDavDisconnectButton" Content="Forget" Tag="5" Click="SignOut_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="WebDavNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Margin="0,4,0,0"/>
            </StackPanel>
        </Expander>

        <!-- ── Folder / network share ── -->
        <Expander x:Name="FolderExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Folder or network share" FontSize="14"/>
                        <TextBlock x:Name="FolderStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="FolderToggle" Tag="4"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <TextBlock Text="A UNC path such as \\server\share\LittleLauncher, another sync client's folder (Dropbox, Seafile, a work OneDrive), or a drive you carry with you."
                           FontSize="12" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Sync Folder" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox x:Name="FolderBox" Width="280"
                                     Text="{Binding SyncFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Browse..." Click="BrowseFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>

        <Expander x:Name="SftpExpander" Style="{StaticResource DestinationExpander}">
            <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SSH / SFTP server" FontSize="14"/>
                        <TextBlock x:Name="SftpStatus" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="SftpToggle" Tag="0"
                                  OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="Destination_Toggled"/>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE770;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Host" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SftpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 192.168.1.100" Width="200"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Port" FontSize="14" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="2" x:Name="PortBox" Value="{Binding SftpPort, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" Width="90"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Username" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SftpUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default: Windows user" Width="200"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Private Key Path" FontSize="14"/>
                            <TextBlock Text="Auto-detected from ~/.ssh/ if empty" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBox Text="{Binding SftpPrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="~/.ssh/id_rsa" Width="200" Margin="0,0,8,0"/>
                            <Button Content="Browse..." Click="BrowseKey_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Remote Path" FontSize="14"/>
                            <TextBlock Text="Directory on the server to store settings" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" Text="{Binding SftpRemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                    </Grid>
                </Border>

                <TextBlock Text="Export or import just the SSH connection settings for use on other machines."
                           FontSize="12" Opacity="0.6" Margin="0,8,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export Connection..." Click="ExportSshConfig_Click"/>
                    <Button Content="Import Connection..." Click="ImportSshConfig_Click"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- ── Shared by every destination ── -->
        <TextBlock Text="Automatic Sync" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72C;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Auto Sync" FontSize="14"/>
                    <TextBlock Text="Sync launcher items on startup, on change, and periodically" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0" IsOn="{Binding SftpAutoSync, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE823;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sync Interval (minutes)" FontSize="14"/>
                    <TextBlock Text="How often to download launcher items" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <NumberBox Grid.Column="2" Value="{Binding SftpAutoSyncInterval, Mode=TwoWay}" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <TextBlock Text="Actions" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
            <Button x:Name="TestButton" Content="Test All" Click="TestConnection_Click"/>
            <Button Content="Upload Launchers" Click="Upload_Click"/>
            <Button Content="Download Launchers" Click="Download_Click"/>
        </StackPanel>

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>

        <!-- Password prompt (SFTP only, shown when needed) -->
        <Border x:Name="PasswordCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D7;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="SFTP Password / Key Passphrase" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,8,0"/>
                    <Button Content="OK" Click="PasswordOk_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
