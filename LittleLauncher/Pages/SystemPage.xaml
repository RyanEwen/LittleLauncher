<Page x:Class="LittleLauncher.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

        <!-- Appearance -->
        <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="App Theme" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding AppTheme, Mode=TwoWay}">
                    <ComboBoxItem Content="System Default"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7FC;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource FlyoutAnimationsTitle}" FontSize="14"/>
                    <TextBlock Text="{StaticResource FlyoutAnimationsDescription}" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                              IsOn="{Binding FlyoutAnimationsEnabled, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Start Menu shortcuts for web launchers. Shown in the positive; DisableWebLauncherShortcuts
             is stored in the negative so it survives WhenWritingDefault, and the inversion lives in
             the code-behind rather than in the model. -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71D;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Start Menu Shortcuts" FontSize="14"/>
                    <TextBlock Text="List web launchers in the Start Menu, so they can be opened from Start search and tools like PowerToys Command Palette"
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="WebShortcutsToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                              Toggled="WebShortcutsToggle_Toggled"/>
            </Grid>
        </Border>

        <TextBlock Text="Tray icon and per-launcher settings are managed on the Launchers page."
                   FontSize="12" Opacity="0.55" Margin="0,4,0,4"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FC;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Launch on Startup" FontSize="14"/>
                    <TextBlock Text="Start minimized to the system tray" FontSize="12" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" x:Name="StartupSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="StartupSwitch_Toggled" IsOn="{Binding Startup, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Browser extensions -->
        <TextBlock Text="Browser Extensions" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE71D;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extensions" FontSize="14"/>
                        <TextBlock FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   Text="Run in every web launcher. Install from the Chrome Web Store inside a launcher, or add an unpacked folder here"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Add Folder..." Click="AddExtensionButton_Click"/>
                </Grid>
                <StackPanel x:Name="ExtensionList" Spacing="4" Margin="36,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Unused browser profiles -->
        <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE74E;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Unused Browser Profiles" FontSize="14"/>
                    <TextBlock x:Name="ProfileCleanupSubtitle" FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                               Text="Checking…"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ProfileCleanupButton" Content="Delete"
                        Click="ProfileCleanupButton_Click" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Backup and Restore -->
        <TextBlock Text="Backup &amp; Restore" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE777;" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Export / Import All Settings" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Export All Settings..." Click="ExportButton_Click"/>
                    <Button Content="Import All Settings..." Click="ImportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>